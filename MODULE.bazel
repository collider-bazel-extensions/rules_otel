"""rules_otel — the OpenTelemetry Collector for Bazel.

Three families in one repo:

  Config (build time):
    otel_config                 — `otelcol-contrib validate` as a
                                  validation action on every build

  Hermetic collector (test time):
    otel_collector_server       — otelcol-contrib on free ports plus an
                                  OTLP sink; writes $TEST_TMPDIR/<name>.env
    otel_collector_health_check — pairs with otel_collector_server
    otel_collector_test         — sh_test macro: auto-launched collector

  Cluster install (kind / production-shaped):
    otel_install / otel_health_check — the pinned opentelemetry-collector
                                  Helm chart, pre-rendered

Pinned: otelcol-contrib 0.151.0 (the release binaries, and the image the
chart deploys), opentelemetry-collector chart 0.153.0.
"""

module(
    name = "rules_otel",
    version = "0.3.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")

# rules_shell is part of the public surface — otel_collector_test is an
# sh_test macro. Bazel 8+ removed `native.sh_test`.
bazel_dep(name = "rules_shell", version = "0.8.0")

# Public binary toolchain. The `otel` extension creates
# otelcol_contrib_<platform> repos at the root module's otel.version(), or
# at this module's when the root names none.
otel = use_extension("//:extensions.bzl", "otel")
otel.version(version = "0.151.0")
use_repo(
    otel,
    "otelcol_contrib_darwin_amd64",
    "otelcol_contrib_darwin_arm64",
    "otelcol_contrib_linux_amd64",
    "otelcol_contrib_linux_arm64",
)
register_toolchains("@rules_otel//toolchain:all")

bazel_dep(name = "rules_kubectl", version = "0.1.0")
git_override(
    module_name = "rules_kubectl",
    remote = "https://github.com/collider-bazel-extensions/rules_kubectl",
    commit = "bb75b97850b08a18abcdca7af86514561a122b03",  # v0.1.0
)

# ---- dev-only: smoke composition --------------------------------------------
bazel_dep(name = "rules_itest", version = "0.0.52", dev_dependency = True)

bazel_dep(name = "rules_kind", version = "0.3.0", dev_dependency = True)
git_override(
    module_name = "rules_kind",
    remote = "https://github.com/collider-bazel-extensions/rules_kind",
    commit = "12a73e02fe4b9400d3dc733a3d80ce06c47b6411",  # v0.3.0 — confirmed deletion + sweep, RULES_KIND_MAX_CLUSTERS
)

bazel_dep(name = "rules_helm", version = "0.2.1", dev_dependency = True)
git_override(
    module_name = "rules_helm",
    remote = "https://github.com/collider-bazel-extensions/rules_helm",
    commit = "48651387d55f0c50f6d059df246ed73767100afb",  # v0.2.1
)

helm = use_extension("@rules_helm//:extensions.bzl", "helm", dev_dependency = True)
helm.version(version = "3.20.2")
use_repo(helm,
    "helm_linux_amd64",
    "helm_darwin_amd64",
    "helm_darwin_arm64",
)
register_toolchains(
    "@helm_linux_amd64//:toolchain",
    "@helm_darwin_amd64//:toolchain",
    "@helm_darwin_arm64//:toolchain",
    dev_dependency = True,
)

otel_chart = use_extension("//tools:extensions.bzl", "otel_chart", dev_dependency = True)
otel_chart.version(version = "0.153.0")
use_repo(otel_chart, "otel_chart_0_153_0")
